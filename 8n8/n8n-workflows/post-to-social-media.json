{
  "name": "Nuwa - Post to Social Media",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "post-content",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "nuwa-post-content"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.platform }}",
        "rules": {
          "rules": [
            {
              "value2": "facebook",
              "output": 0
            },
            {
              "value2": "instagram",
              "output": 1
            }
          ]
        }
      },
      "id": "platform-switch",
      "name": "Platform Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "create",
        "pageId": "={{ $json.facebookPageId }}",
        "message": "={{ $json.caption }}",
        "additionalFields": {
          "link": "={{ $json.mediaUrl }}"
        }
      },
      "id": "facebook-post",
      "name": "Facebook - Create Post",
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [690, 200],
      "credentials": {
        "facebookGraphApi": {
          "id": "1",
          "name": "Facebook Graph API"
        }
      }
    },
    {
      "parameters": {
        "resource": "media",
        "operation": "create",
        "instagramBusinessAccountId": "={{ $json.instagramBusinessAccountId }}",
        "imageUrl": "={{ $json.mediaUrl }}",
        "caption": "={{ $json.caption }}",
        "additionalFields": {}
      },
      "id": "instagram-create-container",
      "name": "Instagram - Create Media Container",
      "type": "n8n-nodes-base.instagram",
      "typeVersion": 1,
      "position": [690, 400],
      "credentials": {
        "instagramGraphApi": {
          "id": "2",
          "name": "Instagram Business API"
        }
      }
    },
    {
      "parameters": {
        "resource": "media",
        "operation": "publish",
        "instagramBusinessAccountId": "={{ $json.instagramBusinessAccountId }}",
        "creationId": "={{ $json.id }}"
      },
      "id": "instagram-publish",
      "name": "Instagram - Publish Media",
      "type": "n8n-nodes-base.instagram",
      "typeVersion": 1,
      "position": [910, 400],
      "credentials": {
        "instagramGraphApi": {
          "id": "2",
          "name": "Instagram Business API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"posted\",\n  \"platform\": \"facebook\",\n  \"platformPostId\": \"{{ $json.id }}\",\n  \"draftId\": \"{{ $('Webhook Trigger').item.json.draftId }}\",\n  \"postedAt\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "facebook-response",
      "name": "Facebook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [910, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"posted\",\n  \"platform\": \"instagram\",\n  \"platformPostId\": \"{{ $json.id }}\",\n  \"draftId\": \"{{ $('Webhook Trigger').item.json.draftId }}\",\n  \"postedAt\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "instagram-response",
      "name": "Instagram Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1130, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"error\",\n  \"message\": \"Invalid platform. Use 'facebook' or 'instagram'\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "error-response",
      "name": "Error - Invalid Platform",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [690, 600]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
